{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-research-example",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  // One binding for both the model and web search. It has no local
  // implementation, so `vite dev` runs it against your Cloudflare account.
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [{ "class_name": "ResearchAgent", "name": "ResearchAgent" }]
  },
  "migrations": [{ "new_sqlite_classes": ["ResearchAgent"], "tag": "v1" }]
}
