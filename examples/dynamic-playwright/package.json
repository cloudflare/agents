{
  "name": "@cloudflare/agents-dynamic-playwright-example",
  "description": "Scratch worker for running Playwright scripts inside dynamically loaded Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "wrangler dev --port 8799",
    "deploy": "wrangler deploy",
    "types": "wrangler types env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@cloudflare/playwright": "1.3.0",
    "@cloudflare/worker-bundler": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260602.1",
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.96.0"
  }
}
