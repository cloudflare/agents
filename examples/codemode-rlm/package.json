{
  "name": "@cloudflare/agents-codemode-rlm-example",
  "description": "Think-hosted recursive language model with Code Mode as its only model-facing tool and Computer Workspace as durable file memory",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "start": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "eval:arc": "pnpm exec tsx eval/run.ts",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types env.d.ts --include-runtime false",
    "test": "vitest run"
  },
  "dependencies": {
    "@cloudflare/codemode": "*",
    "@cloudflare/computer": "0.1.1",
    "@cloudflare/kumo": "^2.6.0",
    "@cloudflare/think": "*",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "*",
    "ai": "^7.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/vitest-pool-workers": "^0.19.0",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@tailwindcss/vite": "^4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "4.1.9",
    "wrangler": "^4.115.0"
  }
}
