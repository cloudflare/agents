{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "next-dynamic-agents-plain",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "Workspace",
        "class_name": "Workspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Workspace"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
