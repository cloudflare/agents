{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "next-mcp-client-capability",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "McpClientObject",
        "class_name": "McpClientObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["McpClientObject"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
