{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "next-routing",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "HubObject",
        "class_name": "HubObject"
      },
      {
        "name": "NoteAgent",
        "class_name": "NoteAgent"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HubObject", "NoteAgent"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
