{
  "name": "@cloudflare/agents-next-tiny-harness-example",
  "description": "Next: a minimal from-scratch coding-agent harness composed from Agents SDK capabilities (Lifecycle, Tasks, Streams, Sessions) with TanStack AI and @cloudflare/computer",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/tests/tsconfig.json",
    "types": "wrangler types worker-env.d.ts --include-runtime false --env-file .dev.vars.example",
    "test": "vitest run --config src/tests/vitest.config.ts",
    "postinstall": "pnpm run types"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.0",
    "@cloudflare/computer": "^0.3.0",
    "@tanstack/ai": "^0.54.0",
    "@tanstack/ai-cloudflare": "^0.1.1",
    "@tanstack/ai-react": "^0.27.0",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-start": "^1.168.56",
    "agents": "*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.40",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "4.1.10",
    "wrangler": "^4.115.0"
  }
}
