{
  // Standalone rather than extending the repo root, so this example can be
  // copied out of the monorepo and still type-check on its own.
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // `vite/client` is what declares `import.meta.glob`, which skills.ts uses
    // to inline src/skills/*/SKILL.md into the bundle: a Worker has no
    // filesystem at runtime, so node:fs cannot read those files.
    "types": ["node", "@cloudflare/workers-types", "vite/client"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  // `worker-env.d.ts` is generated by `wrangler types` on postinstall and is
  // not committed, so `Env` and the Durable Object bindings stay in sync with
  // wrangler.jsonc automatically.
  "include": ["src", "web", "worker-env.d.ts", "env.d.ts"],
  // The tests are type-checked by src/tests/tsconfig.json, which adds the
  // `cloudflare:test` types and the test-only bindings.
  "exclude": ["src/tests"]
}
