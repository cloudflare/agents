{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "worker.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "CompiledWasm", "globs": ["**/*.wasm"] }],
  "durable_objects": {
    "bindings": [
      { "name": "CODEX_HARNESS_TEST", "class_name": "CodexHarnessTestObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CodexHarnessTestObject"] }
  ]
}
