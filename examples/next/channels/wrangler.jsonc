{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "channels",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/channels/*"]
  },
  "durable_objects": {
    "bindings": [
      { "class_name": "ThinkAgent", "name": "ThinkAgent" },
      { "class_name": "PiAgent", "name": "PiAgent" }
    ]
  },
  "migrations": [
    { "new_sqlite_classes": ["AiSdkAgent"], "tag": "v1" },
    { "new_sqlite_classes": ["PiAgent"], "tag": "v2" },
    {
      "deleted_classes": ["AiSdkAgent"],
      "new_sqlite_classes": ["ThinkAgent"],
      "tag": "v3"
    }
  ]
}
