---
import { codeToHtml } from 'shiki';
import { BackgroundDots } from './_components/background';
import { InstallCommand } from './_components/install-command';

const codeExampleChat = `import { DurableObject } from 'cloudflare:workers';
import { createModels } from '@earendil-works/pi-ai/models';
import { createRegistry, Harness } from '@earendil-works/pi-durable';
import { PiHarness } from 'agents/harness/pi';
import { Lifecycle } from 'agents/lifecycle';
import { createAI } from 'agents/models/pi-ai';
import { Scheduler } from 'agents/schedules';
import { restaurantTools, chooseWinners } from '../utils';

export class LunchAgent extends DurableObject<Env> {
	ai = createAI({ binding: this.env.AI });
	registry = createRegistry();

	// Pi runs the model loop, and picks up where it left off after an eviction
	harness = new PiHarness({
		harness: ({ storage, context, onWake }) => {
			// Browser search and a vector store of menus, as Pi tools
			this.registry.install(restaurantTools(this.env));
			const models = createModels();
			models.setProvider(this.ai.provider);
			return Harness.open(storage, { models, registry: this.registry, onWake }, context);
		},
		defaults: { model: this.ai('@cf/zai-org/glm-5.3-flash') },
	});

	scheduler = new Scheduler({
		callbacks: {
			chooseLunch: () => this.chooseLunch(),
			resetLunch: () => this.resetLunch(),
		},
	});

	lifecycle = Lifecycle.install(this).use(this.scheduler).use(this.harness);

	async onStart() {
		this.ctx.storage.sql.exec(
			'CREATE TABLE IF NOT EXISTS votes (username TEXT PRIMARY KEY, restaurant TEXT)'
		);
		await this.scheduler.set('30 11 * * 1-5', 'chooseLunch'); // Weekdays at 11:30
		await this.scheduler.set('0 17 * * *', 'resetLunch'); // Daily at 17:00
	}

	async nominateRestaurant(name: string) {
		// Pi finds the menu with its browser tool and saves it
		await this.harness.submit(\`Find the menu for \${name} and save it.\`);
	}

	async searchRestaurants(query: string) {
		const { text } = await this.harness.prompt(\`Which saved restaurants serve \${query}?\`);
		return text;
	}

	vote(username: string, restaurant: string) {
		this.ctx.storage.sql.exec(
			'INSERT OR REPLACE INTO votes VALUES (?, ?)',
			username,
			restaurant
		);
	}

	async chooseLunch() {
		const votes = this.ctx.storage.sql.exec<Vote>('SELECT * FROM votes').toArray();
		await this.harness.submit(
			\`Today's winners: \${chooseWinners(votes).join(', ')}. Announce lunch \` +
				'so that people who voted for something else feel validated.'
		);
	}

	async resetLunch() {
		this.ctx.storage.sql.exec('DELETE FROM votes');
		await this.harness.session().reset();
	}
}

export type Vote = {
	username: string;
	restaurant: string;
};`;

const chatExample = await codeToHtml(codeExampleChat, {
  lang: 'typescript',
  theme: 'gruvbox-light-medium',
  colorReplacements: {
    '#fbf1c7': '#fff',
    '#076678': 'oklch(.408 .123 38.172)',
    '#3c3836': 'var(--color-orange-700)',
    '#B57614': 'var(--color-orange-600)'
  }
});
---

<div class="pt-24">
  <header class="p-6 pt-0 border-b border-orange-400 border-dashed">
    <h3
      class="text-sm text-orange-600"
      id="developer-instructions"
      style="scroll-margin-top: 90px"
    >
      <span class="tabular-nums">03</span> | Code Example
    </h3>
  </header>
  <div class="relative">
    <div class="absolute inset-3 bottom-0 text-orange-400">
      <BackgroundDots client:load />
    </div>
    <div class="p-6 pt-10 md:p-12 md:pb-0 pb-0 flex items-center flex-col">
      <div class="border border-orange-400 border-b-0 p-6 rounded-t-lg bg-white relative">
        <header class="flex gap-1 mb-2 lg:mb-6">
          <div class="w-4 h-4 border border-orange-400 rounded-full"></div>
          <div class="w-4 h-4 border border-orange-400 rounded-full"></div>
          <div class="w-4 h-4 border border-orange-400 rounded-full"></div>
        </header>
        <div class="font-mono text-2xl lg:text-4xl">
          <InstallCommand client:load />
        </div>
      </div>
    </div>
    <div class="divide-y divide-orange-400 border-t lg:border border-orange-400 w-full lg:max-w-[950px] bg-white relative lg:border-b-0 lg:rounded-t-xl mx-auto">
      <header class="flex flex-col md:flex-row items-baseline gap-2 py-4 ml-6 mr-3">
        <h3 class="text-xl font-semibold">
          <span>Lunch Agent</span>
        </h3>
        <p>An agent that helps pick lunch for coworkers in an office.</p>
      </header>
      <pre
        class="text-sm leading-normal pl-6 pr-3 py-5 overflow-x-auto"
        set:html={chatExample}
      />
    </div>
  </div>
</div>

