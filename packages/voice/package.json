{
  "name": "@cloudflare/voice",
  "version": "0.5.0",
  "description": "Compatibility package for the Agents SDK voice exports",
  "repository": {
    "directory": "packages/voice",
    "type": "git",
    "url": "git+https://github.com/cloudflare/agents.git"
  },
  "bugs": {
    "url": "https://github.com/cloudflare/agents/issues"
  },
  "peerDependencies": {
    "agents": ">=0.23.0 <2.0.0",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/voice.d.ts",
      "import": "./dist/voice.js",
      "require": "./dist/voice.js"
    },
    "./client": {
      "types": "./dist/voice-client.d.ts",
      "import": "./dist/voice-client.js",
      "require": "./dist/voice-client.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.js"
    },
    "./react": {
      "types": "./dist/voice-react.d.ts",
      "import": "./dist/voice-react.js",
      "require": "./dist/voice-react.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsx ./scripts/build.ts",
    "test": "vitest --run"
  },
  "keywords": [
    "cloudflare",
    "agents",
    "voice",
    "stt",
    "tts",
    "vad",
    "speech",
    "realtime"
  ],
  "author": "Cloudflare Inc.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "nx": {
    "targets": {
      "build": {
        "inputs": [
          "production",
          "^production",
          "{workspaceRoot}/docs/voice/**/*",
          "{workspaceRoot}/scripts/copy-package-docs.ts"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/docs"
        ]
      }
    }
  },
  "devDependencies": {
    "agents": "workspace:*"
  }
}
