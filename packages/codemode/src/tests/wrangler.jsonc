{
  "name": "codemode-worker-javascript-tests",
  "main": "worker.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "HOST", "class_name": "BackendTestHost" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BackendTestHost"] }]
}
