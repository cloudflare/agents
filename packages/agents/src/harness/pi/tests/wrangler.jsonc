{
  "main": "worker.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "PI_HARNESS_TEST", "class_name": "PiHarnessTestObject" },
      { "name": "PI_STORE_TEST", "class_name": "PiStoreTestObject" },
      { "name": "PI_NO_DEFAULTS_TEST", "class_name": "PiNoDefaultsTestObject" },
      { "name": "PI_FACTORY_TEST", "class_name": "PiFactoryTestObject" },
      {
        "name": "PI_FLAKY_FACTORY_TEST",
        "class_name": "PiFlakyFactoryTestObject"
      },
      { "name": "PI_BROWSER_TEST", "class_name": "PiBrowserTestObject" },
      // The browser tool's codemode runtime facet. The test pool needs a
      // binding for ctx.exports to hand it out; it stays out of
      // new_sqlite_classes, since the host owns the SQLite store.
      { "name": "CodemodeRuntime", "class_name": "CodemodeRuntime" }
    ]
  },
  // The browser tool runs model code in Dynamic Workers minted through this.
  "worker_loaders": [{ "binding": "LOADER" }],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PiHarnessTestObject",
        "PiStoreTestObject",
        "PiNoDefaultsTestObject",
        "PiFactoryTestObject",
        "PiFlakyFactoryTestObject",
        "PiBrowserTestObject"
      ]
    }
  ]
}
