      },
      {
        "name": "FailingOnStartServer",
        "class_name": "FailingOnStartServer"
      },
      {
        "name": "HibernatingNameInMessage",
        "class_name": "HibernatingNameInMessage"
      },
      {
        "name": "TagsServer",
        "class_name": "TagsServer"
      },
      {
        "name": "TagsServerInMemory",
        "class_name": "TagsServerInMemory"
      },
      {
        "name": "UriServer",
        "class_name": "UriServer"
      },
      {
        "name": "UriServerInMemory",
        "class_name": "UriServerInMemory"
      },
      {
        "name": "PropsServer",
        "class_name": "PropsServer"
