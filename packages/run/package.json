{
  "name": "@cloudflare/run",
  "version": "0.0.0",
  "description": "Run JavaScript in isolated Cloudflare Dynamic Workers",
  "repository": {
    "directory": "packages/run",
    "type": "git",
    "url": "git+https://github.com/cloudflare/agents.git"
  },
  "bugs": {
    "url": "https://github.com/cloudflare/agents/issues"
  },
  "types": "dist/index.d.ts",
  "exports": {
