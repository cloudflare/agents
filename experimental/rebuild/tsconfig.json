{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022",
      "dom"
    ],
    "module": "commonjs",
    "moduleResolution": "node10",
    "rootDir": "..",
    "outDir": "dist",
    "strict": true,
    "noUnusedLocals": true,
    "exactOptionalPropertyTypes": true,
    "declaration": false,
    "sourceMap": false,
    "types": [],
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "ai": [
        "vendor/node_modules/ai"
      ],
      "workers-ai-provider": [
        "vendor/node_modules/workers-ai-provider"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "src",
    "tests",
    "../contract/src"
  ]
}