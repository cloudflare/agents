{
  "name": "@cloudflare/agents-exo-harness-experiment",
  "description": "Exo-style recursive self-modifying agent: a stable kernel Durable Object with an append-only journal hot-loads its own evolvable harness (identity, policy, tools) from a durable Workspace via dynamic Worker isolates",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "scripts": {
    "start": "vite dev",
    "start:offline": "EXO_OFFLINE=1 vite dev",
    "deploy": "vite build && wrangler deploy",
    "test": "vitest run",
    "types": "wrangler types env.d.ts --include-runtime false"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@ai-sdk/provider": "^4.0.0",
    "@cloudflare/ai-chat": "*",
    "@cloudflare/computer": "^0.2.1",
    "@cloudflare/kumo": "^2.6.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^1.1.1",
    "agents": "*",
    "ai": "^7.0.0",
    "jose": "^6.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "streamdown": "^2.5.0",
    "workers-ai-provider": "^4.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@cloudflare/vitest-pool-workers": "^0.19.1",
    "@cloudflare/workers-types": "^5.20260729.1",
    "@tailwindcss/vite": "^4",
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "vitest": "4.1.10",
    "wrangler": "^4.115.0"
  }
}
