{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "self-modifying",
  "account_id": "b8afc92c7a87f699592038b756153d22",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  // "experimental" is local-only (miniflare gates the worker backends'
  // loopback behind it); production has the same features enabled by
  // compatibility date — verified with a live probe worker.
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI", "remote": true },
  // Per-agent harness git mirror. Absent from wrangler.offline.jsonc and the
  // test config: the kernel skips pushing when the binding is missing.
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "exo-harness", "remote": true }
  ],
  "vars": {
    // "" = use /harness/policy.json; "mock" = offline; "workers-ai:<id>"
    // = Workers AI; "openai/<id>" = the managed team AI Gateway.
    "MODEL_OVERRIDE": "",
    // Environment prefix for per-agent Artifacts repo names, so prod and
    // local dev agents with the same name never share (and force-push
    // over) the same mirror.
    "ARTIFACTS_REPO_PREFIX": "exo-prod",
    // Non-secret JWT verification values from the hostname Access app.
    "AUTH_MODE": "access",
    "ACCESS_TEAM_DOMAIN": "https://agents-b8a.cloudflareaccess.com",
    "ACCESS_AUD": "1cf54107d8ab7674caca49494009351ffced88698cfab01b968a691a0c3c1b67",
    "DEVELOPMENT_ACCESS_SUBJECT": "",
    "DEVELOPMENT_ACCESS_EMAIL": ""
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  // The production workers.dev route sits behind Cloudflare Access; keep
  // version preview URLs off so deploys never open an unprotected side door.
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agent"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ExoKernel",
        "name": "ExoKernel"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ExoKernel"],
      "tag": "v1"
    }
  ]
}
