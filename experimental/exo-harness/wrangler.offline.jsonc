// Offline dev config: identical to wrangler.jsonc minus the Workers AI and
// Artifacts bindings, so `pnpm run start:offline` runs with zero Cloudflare
// credentials (the deterministic mock model driver). Keep the three configs
// (wrangler.jsonc / wrangler.dev.jsonc / this one) in sync.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exo-harness",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "vars": {
    "MODEL_OVERRIDE": "mock"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agents/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ExoKernel",
        "name": "ExoKernel"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ExoKernel"],
      "tag": "v1"
    },
    {
      // Fresh start for the @cloudflare/computer substrate swap: delete
      // and recreate the class, wiping every pre-swap DO instance.
      "deleted_classes": ["ExoKernel"],
      "new_sqlite_classes": ["ExoKernel"],
      "tag": "v2"
    }
  ]
}
