// Offline dev config: identical to wrangler.jsonc minus the Workers AI and
// Artifacts bindings, so `pnpm run start:offline` runs with zero Cloudflare
// credentials (the deterministic mock model driver). Keep the three configs
// (wrangler.jsonc / wrangler.dev.jsonc / this one) in sync.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exo-harness",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "worker_loaders": [{ "binding": "LOADER" }],
  "vars": {
    "MODEL_OVERRIDE": "mock",
    // Explicit local identity: production uses verified Cloudflare Access.
    "AUTH_MODE": "development",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEVELOPMENT_ACCESS_SUBJECT": "local-developer",
    "DEVELOPMENT_ACCESS_EMAIL": "developer@cloudflare.com"
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agent"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ExoKernel",
        "name": "ExoKernel"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ExoKernel"],
      "tag": "v1"
    },
    {
      // Fresh start for the @cloudflare/computer substrate swap: v2
      // deleted the class (applied via an intermediate deploy with the
      // binding removed — the API refuses a delete while a binding
      // references the class) and v3 recreated it empty.
      "deleted_classes": ["ExoKernel"],
      "tag": "v2"
    },
    {
      "new_sqlite_classes": ["ExoKernel"],
      "tag": "v3"
    }
  ]
}
