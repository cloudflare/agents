// Local dev config with REAL remote bindings (AI + Artifacts). Identical to
// wrangler.jsonc except for the worker name: the remote-bindings tunnel
// rides the worker's own workers.dev host, and the production host
// (self-modifying.<subdomain>.workers.dev) is protected by Cloudflare Access —
// which would 302 every binding call. A separate dev name keeps the tunnel
// on an unprotected host. Keep the three configs in sync.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "self-modifying-dev",
  "account_id": "b8afc92c7a87f699592038b756153d22",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "experimental"],
  "ai": { "binding": "AI", "remote": true },
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "exo-harness", "remote": true }
  ],
  "vars": {
    "MODEL_OVERRIDE": "",
    "ARTIFACTS_REPO_PREFIX": "exo-dev",
    // Explicit local identity: production uses verified Cloudflare Access.
    "AUTH_MODE": "development",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "DEVELOPMENT_ACCESS_SUBJECT": "local-developer",
    "DEVELOPMENT_ACCESS_EMAIL": "developer@cloudflare.com"
  },
  "worker_loaders": [{ "binding": "LOADER" }],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/agent"]
  },
  "durable_objects": {
    "bindings": [
      {
        "class_name": "ExoKernel",
        "name": "ExoKernel"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["ExoKernel"],
      "tag": "v1"
    }
  ]
}
