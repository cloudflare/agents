{
  "name": "@cloudflare/agents-nightly",
  "description": "Long end-to-end suites the nightly workflow runs against real deployments",
  "private": true,
  "type": "module",
  "scripts": {
    "faults": "vitest run -c faults/vitest.config.ts",
    "upgrade": "vitest run -c upgrade/vitest.config.ts",
