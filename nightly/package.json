    "soak": "vitest run -c soak/vitest.config.ts",
    "perf": "tsx perf/report.ts",
    "fuzz": "vitest run -c faults/fuzz.config.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.0",
    "@cloudflare/ai-chat": "*",
