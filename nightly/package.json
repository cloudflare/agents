    "@earendil-works/pi-codemode": "~1.6.1",
    "@earendil-works/pi-durable": "~1.6.1",
    "@earendil-works/pi-schema": "~1.6.1",
    "@opencode/plugin": "2.0.24",
    "@opencode/sdk": "2.0.24",
    "agents": "*",
    "ai": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "vitest": "4.1.11",
